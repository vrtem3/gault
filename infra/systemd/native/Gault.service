[Unit]
Description=Gault account API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gault
Group=gault
WorkingDirectory=/opt/Gault/backend
EnvironmentFile=/etc/Gault/Gault.env
Environment=PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
ExecStartPre=/opt/Gault/.venv/bin/python -m alembic upgrade head
ExecStart=/opt/Gault/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 18000 --workers 1 --no-access-log --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
StateDirectory=Gault
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
MemoryHigh=384M
MemoryMax=512M
MemorySwapMax=0
CPUQuota=50%
CPUWeight=20
IOWeight=20
Nice=10
TasksMax=128
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
