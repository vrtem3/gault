{
	email {$TLS_EMAIL}
	admin off
}

(common_headers) {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	encode zstd gzip
}

{$DOMAIN} {
	import common_headers
	root * /srv/cipher
	route {
		@sw path /sw.js
		header @sw {
			Content-Security-Policy "default-src 'none'; script-src 'self'; connect-src 'self'; object-src 'none'"
			Cache-Control no-cache
			Service-Worker-Allowed /
		}
		@document not path /sw.js
		header @document Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' blob:; font-src 'self'; connect-src 'none'; worker-src 'self'; manifest-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		header X-Frame-Options DENY
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control no-cache
		@api path /api /api/*
		respond @api 404
		file_server
	}
}

account.{$DOMAIN} {
	import common_headers
	route {
		@api path /api/*
		handle @api {
			request_body {
				max_size 8KB
			}
			reverse_proxy api:8000
		}
		handle {
			root * /srv/account
			header Cache-Control no-cache
			@bridge path /_telemetry.html
			header @bridge {
				Content-Security-Policy "default-src 'none'; script-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors https://{$DOMAIN}"
				Cache-Control no-store
			}
			@account not path /_telemetry.html
			header @account {
				Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; base-uri 'none'; object-src 'none'; form-action 'none'; frame-ancestors 'none'"
				X-Frame-Options DENY
			}
			header /assets/* Cache-Control "public, max-age=31536000, immutable"
			file_server
		}
	}
}
